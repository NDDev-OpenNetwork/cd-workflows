{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NDDev-OpenNetwork/cd-workflows/schemas/v1/deployment-state.schema.json",
  "title": "NDDev deployment state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "deployment_id", "plan_digest", "state", "generation", "updated_at", "history"],
  "properties": {
    "schema": {"const": "nddev-cd-state/v1"},
    "deployment_id": {"type": "string", "pattern": "^deploy_[0-9A-Z]{26}$"},
    "plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "state": {"enum": ["DRAFT", "VALIDATED", "PLANNED", "APPROVED", "APPLYING", "VERIFYING", "SUCCEEDED", "FAILED_RETRYABLE", "RESUMING", "FAILED_ROLLBACK_REQUIRED", "ROLLING_BACK", "ROLLED_BACK", "BLOCKED"]},
    "generation": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "history": {"type": "array", "minItems": 1}
  }
}
